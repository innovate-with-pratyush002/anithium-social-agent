APP_NAME=Anithium Social Agent
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-chars
CORS_ORIGINS=["http://localhost:3000"]
POSTGRES_DB=anithium
POSTGRES_USER=anithium
POSTGRES_PASSWORD=change-this-to-a-long-alphanumeric-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://anithium:change-this-to-a-long-alphanumeric-password@postgres:5432/anithium
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Select exactly one active provider: groq, openai, or gemini.
AI_PROVIDER=groq

# Groq (default provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI (optional; select AI_PROVIDER=openai to use it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (optional; select AI_PROVIDER=gemini to use it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
