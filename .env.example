APP_NAME=Anithium Social Agent
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-chars
CORS_ORIGINS=["http://localhost:3000"]
POSTGRES_DB=anithium
POSTGRES_USER=anithium
POSTGRES_PASSWORD=change-this-to-a-long-alphanumeric-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://anithium:change-this-to-a-long-alphanumeric-password@postgres:5432/anithium
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: configure to enable live AI content generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
